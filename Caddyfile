# Portal router (M-237): ONE hostname, portal.ddvnguyen.com. Tab UI + /p/<port>/ gateway to allowlisted localhost ports.
{
	admin localhost:2022
	auto_https off
	default_bind 127.0.0.1 10.88.0.1 192.168.7.99
	servers {
		protocols h1
	}
}

http://portal.ddvnguyen.com:3720 {
	log
	import routes/lease.inc
	import routes/ports.inc
	import routes/muximux.inc
}

http://:3720 {
	respond "not registered" 404
}

+function enginePorts(): EnginePorts | null {
+  const url = process.env.PORTS_API_URL?.trim()
+  const tokenFile = process.env.PORTS_API_TOKEN_FILE?.trim()
+  if (!url || !tokenFile) return null
+  let token: string
+  try {
+    token = readFileSync(tokenFile, 'utf8').trim()
+  } catch {
+    return null
+  }
+  if (!token) return null
+  const base = url.replace(/\/+$/, '')
+  const call = async (
+    method: string,
+    reqPath: string,
+    body?: unknown,
+  ): Promise<void> => {
+    const controller = new AbortController()
+    const timer = setTimeout(() => controller.abort(), 2000)
+    timer.unref?.()
+    try {
+      const response = await fetch(`${base}${reqPath}`, {
+        method,
+        headers: {
+          'X-Ports-Token': token,
+          ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}),
+        },
+        body: body !== undefined ? JSON.stringify(body) : undefined,
+        signal: controller.signal,
+      })
+      await response.text().catch(() => '')
+    } catch {
+      // Registry down never blocks the proxy; removal retries next cycle.
+    } finally {
+      clearTimeout(timer)
+    }
+  }
+  return {
+    register: async (_id, record) => {
+      await call('POST', '/v1/ports', record)
+    },
+    remove: async (id) => {
+      await call('DELETE', `/v1/ports/${encodeURIComponent(id)}`)
+    },
+  }
+}
 

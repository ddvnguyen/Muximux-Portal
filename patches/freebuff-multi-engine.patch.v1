+/**
+ * Multi-engine mode: stamp the proxied document with the engine version and
+ * account so the browser shows which engine it is talking to. Document
+ * responses only; the engine CSP allows same-origin connect and has no
+ * style-src/default-src, so an inline-style badge needs no CSP change.
+ */
+function stampVersionBadge(body: string, options: ProxyOptions): string {
+  const version = options.versionLabel?.trim() || 'unknown'
+  const account = options.accountLabel?.trim() || 'engine'
+  const title = `Freebuff Desktop ${version} · ${account}`
+  const stamped = body.replace(/<title>.*?<\/title>/i, `<title>${title}</title>`)
+  return `${stamped}<div style="position:fixed;bottom:8px;right:8px;z-index:99999;background:#111;color:#fff;font:12px sans-serif;padding:4px 8px;border-radius:6px;opacity:.85">${title}</div>`
+}
 

+function profileKey(profilePath: string): string {
+  const match = profilePath.match(/accounts\/([^/]+)/)
+  return match?.[1] ?? ''
+}
+
+type RegistryConfig = { url: string; token: string }
+
+function registryConfig(): RegistryConfig | null {
+  const url = process.env.PORTS_API_URL?.trim()
+  const tokenFile = process.env.PORTS_API_TOKEN_FILE?.trim()
+  if (!url || !tokenFile) return null
+  try {
+    const token = readFileSync(tokenFile, 'utf8').trim()
+    if (!token) return null
+    return { url: url.replace(/\/+$/, ''), token }
+  } catch {
+    return null
+  }
+}
+
+async function registryRequest(
+  cfg: RegistryConfig,
+  method: string,
+  path: string,
+  body?: unknown,
+  timeoutMs = 2000,
+): Promise<void> {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), timeoutMs)
+  timer.unref?.()
+  try {
+    await fetch(`${cfg.url}${path}`, {
+      method,
+      headers: {
+        'X-Ports-Token': cfg.token,
+        ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}),
+      },
+      body: body !== undefined ? JSON.stringify(body) : undefined,
+      signal: controller.signal,
+    })
+  } catch {
+    // Registry down must never affect Freebuff start.
+  } finally {
+    clearTimeout(timer)
+  }
+}
